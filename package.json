{
  "name": "sipro",
  "private": true,
  "version": "1.4.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "6.5.438",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "description": "Sistema Procuradorias",
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.sipro.desktop",
    "productName": "Sistema Procuradorias",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sistema-Procuradorias-Setup-${version}.${ext}",
      "icon": "public/logo-sipro.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Sistema Procuradorias"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aqnoeu",
        "repo": "sispro",
        "releaseType": "release",
        "private": false
      }
    ]
  }
}
